    "import sys\n",
    "from pathlib import Path\n",
    "import warnings\n",
    "import shutil\n",
    "import os\n",
    "import pandas as pd\n",
    "\n",
    "warnings.filterwarnings(\"ignore\", message=\"X does not have valid feature names\")\n",
    "\n",
    "ROOT = Path(r\"C:\\Users\\Prabu\\Downloads\\Katabatic\").resolve()\n",
    "if str(ROOT) not in sys.path:\n",
    "    sys.path.insert(0, str(ROOT))\n",
    "\n",
    "print(\"ROOT set to:\", ROOT)\n",
    "\n",
    "from katabatic.pipeline.train_test_split.pipeline import TrainTestSplitPipeline\n",
    "from utils import discretize_preprocess\n",
    "from katabatic.models.great.models import GReaT\n",
    "\n",
    "\n",
    "class CustomGReaT(GReaT):\n",
    "    \"\"\"\n",
    "    Wrapper that avoids the internal clamp in model.py (epochs->2, batch_size->2).\n",
    "    We do NOT edit model.py. We override train() to run properly in pipeline-mode.\n",
    "    \"\"\"\n",
    "\n",
    "    def train(self, *args, **kwargs):\n",
    "        # Pipeline-mode: TrainTestSplitPipeline passes dataset_dir as first arg (string path)\n",
    "        if len(args) >= 1 and isinstance(args[0], str):\n",
    "            dataset_dir = args[0]\n",
    "            synthetic_dir = kwargs.get(\"synthetic_dir\")\n",
    "\n",
    "            x_train_path = os.path.join(dataset_dir, \"x_train.csv\")\n",
    "            y_train_path = os.path.join(dataset_dir, \"y_train.csv\")\n",
    "\n",
    "            X_train = pd.read_csv(x_train_path)\n",
    "            y_train_df = pd.read_csv(y_train_path)\n",
    "            y_train = y_train_df.iloc[:, 0] if y_train_df.shape[1] == 1 else y_train_df\n",
    "\n",
    "            # combine (label last column)\n",
    "            df_train = pd.concat([X_train, y_train], axis=1)\n",
    "\n",
    "            # train using user epochs/batch_size (no clamping)\n",
    "            self.fit(df_train)\n",
    "\n",
    "            # --------- Generate bigger synthetic set ---------\n",
    "            n_rows = len(df_train)\n",
    "            gen_rows = int(n_rows * 4)  # generate 4x, then rebalance down\n",
    "\n",
    "            df_synth = self.sample(\n",
    "                gen_rows,\n",
    "                device=\"cpu\",            # set \"cuda\" only if you truly have GPU working\n",
    "                guided_sampling=True,\n",
    "                temperature=0.8,\n",
    "                max_length=256,\n",
    "                k=max(8, min(64, gen_rows)),\n",
    "                drop_nan=True\n",
    "            )\n",
    "\n",
    "            x_synth = df_synth.iloc[:, :-1].copy()\n",
    "            y_synth = df_synth.iloc[:, -1].copy()\n",
    "\n",
    "            # Align feature columns exactly to training features\n",
    "            real_cols = X_train.columns.tolist()\n",
    "            if len(real_cols) == x_synth.shape[1]:\n",
    "                x_synth.columns = real_cols\n",
    "                x_synth = x_synth.reindex(columns=real_cols)\n",
    "\n",
    "            # ---------- Rebalance synthetic labels to match real distribution ----------\n",
    "            y_name = y_train.name if hasattr(y_train, \"name\") and y_train.name else \"target\"\n",
    "            try:\n",
    "                y_synth = y_synth.astype(y_train.dtype)\n",
    "            except:\n",
    "                pass\n",
    "\n",
    "            target_frac = y_train.value_counts(normalize=True)\n",
    "            keep_idx = []\n",
    "\n",
    "            for cls, frac in target_frac.items():\n",
    "                need = int(frac * n_rows)\n",
    "                cls_idx = y_synth[y_synth == cls].index.tolist()\n",
    "                keep_idx += cls_idx[:need]\n",
    "\n",
    "            if len(keep_idx) == 0:\n",
    "                x_synth = x_synth.head(n_rows).reset_index(drop=True)\n",
    "                y_synth = y_synth.head(n_rows).reset_index(drop=True)\n",
    "            else:\n",
    "                x_synth = x_synth.loc[keep_idx].reset_index(drop=True)\n",
    "                y_synth = y_synth.loc[keep_idx].reset_index(drop=True)\n",
    "\n",
    "            # ensure output dir\n",
    "            if synthetic_dir is None:\n",
    "                synthetic_dir = os.path.join(ROOT, \"synthetic\", \"car\", \"great\")\n",
    "            os.makedirs(synthetic_dir, exist_ok=True)\n",
    "\n",
    "            x_path = os.path.join(synthetic_dir, \"x_synth.csv\")\n",
    "            y_path = os.path.join(synthetic_dir, \"y_synth.csv\")\n",
    "\n",
    "            x_synth.to_csv(x_path, index=False)\n",
    "            pd.DataFrame(y_synth, columns=[y_name]).to_csv(y_path, index=False)\n",
    "\n",
    "            print(\"✅ Saved synthetic:\", x_path, y_path)\n",
    "            print(\"✅ Synthetic rows:\", len(x_synth))\n",
    "\n",
    "            return self\n",
    "\n",
    "        # fallback to normal behaviour\n",
    "        return super().train(*args, **kwargs)\n",
    "\n",
    "\n",
    "# -----------------------------\n",
    "# RUN FOR CAR DATASET\n",
    "# -----------------------------\n",
    "dataset_name = \"car\"\n",
    "\n",
    "raw_csv  = ROOT / \"raw_data\" / f\"{dataset_name}.csv\"\n",
    "disc_csv = ROOT / \"discretized_data\" / f\"{dataset_name}.csv\"\n",
    "disc_csv.parent.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "print(f\"Discretizing {raw_csv} -> {disc_csv}\")\n",
    "discretize_preprocess(str(raw_csv), str(disc_csv))\n",
    "\n",
    "input_csv     = str(disc_csv)\n",
    "output_dir    = str(ROOT / \"sample_data\" / dataset_name)\n",
    "real_test_dir = output_dir\n",
    "synthetic_dir = str(ROOT / \"synthetic\" / dataset_name / \"great\")\n",
    "\n",
    "# clean old synthetic folder\n",
    "great_dir = Path(synthetic_dir)\n",
    "if great_dir.exists():\n",
    "    shutil.rmtree(great_dir)\n",
    "great_dir.mkdir(parents=True, exist_ok=True)\n",
    "print(\"✅ Cleaned synthetic folder:\", great_dir)\n",
    "\n",
    "pipeline = TrainTestSplitPipeline(\n",
    "    model=lambda: CustomGReaT(\n",
    "        llm=\"distilgpt2\",\n",
    "        experiment_dir=str(ROOT / \"trainer_great\" / dataset_name),\n",
    "        epochs=1,              # doesn’t matter when max_steps is set\n",
    "        batch_size=8,\n",
    "        report_to=[],\n",
    "\n",
    "        max_steps=10,          # ✅ THIS makes it [1/10], [2/10]...\n",
    "        save_strategy=\"no\",\n",
    "        logging_steps=1,\n",
    "        dataloader_pin_memory=False,\n",
    "        dataloader_num_workers=0,\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "result = pipeline.run(\n",
    "    input_csv=input_csv,\n",
    "    output_dir=output_dir,\n",
    "    synthetic_dir=synthetic_dir,\n",
    "    real_test_dir=real_test_dir,\n",
    "    size_category=\"small\",\n",
    ")\n",
    "\n",
    "print(\"\\n✅ Training + TSTR completed\")\n",
    "print(\"✅ Results saved to:\", ROOT / \"Results\" / dataset_name)\n",
    "print(result)\n"
   ]
  },
