    "import sys\n",
    "from pathlib import Path\n",
    "import warnings\n",
    "import shutil\n",
    "\n",
    "warnings.filterwarnings(\"ignore\", message=\"X does not have valid feature names\")\n",
    "\n",
    "ROOT = Path(r\"C:\\Users\\Prabu\\Downloads\\Katabatic\").resolve()\n",
    "if str(ROOT) not in sys.path:\n",
    "    sys.path.insert(0, str(ROOT))\n",
    "\n",
    "print(\"ROOT set to:\", ROOT)\n",
    "\n",
    "from katabatic.pipeline.train_test_split.pipeline import TrainTestSplitPipeline\n",
    "from utils import discretize_preprocess\n",
    "from katabatic.models.great.models import GReaT\n",
    "\n",
    "dataset_name = \"car\"\n",
    "\n",
    "raw_csv = ROOT / \"raw_data\" / f\"{dataset_name}.csv\"\n",
    "disc_csv = ROOT / \"discretized_data\" / f\"{dataset_name}.csv\"\n",
    "disc_csv.parent.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "discretize_preprocess(str(raw_csv), str(disc_csv))\n",
    "\n",
    "input_csv = str(disc_csv)\n",
    "output_dir = str(ROOT / \"sample_data\" / dataset_name)\n",
    "real_test_dir = output_dir\n",
    "synthetic_dir = str(ROOT / \"synthetic\" / dataset_name / \"great\")\n",
    "\n",
    "great_dir = Path(synthetic_dir)\n",
    "if great_dir.exists():\n",
    "    shutil.rmtree(great_dir)\n",
    "great_dir.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "pipeline = TrainTestSplitPipeline(\n",
    "    model=lambda: GReaT(\n",
    "        llm=\"distilgpt2\",\n",
    "        experiment_dir=str(ROOT / \"trainer_great\" / dataset_name),\n",
    "        epochs=100,\n",
    "        batch_size=8,\n",
    "        efficient_finetuning=\"\",\n",
    "        float_precision=None,\n",
    "        report_to=[],\n",
    "    )\n",
    ")\n",
    "\n",
    "result = pipeline.run(\n",
    "    input_csv=input_csv,\n",
    "    output_dir=output_dir,\n",
    "    synthetic_dir=synthetic_dir,\n",
    "    real_test_dir=real_test_dir,\n",
    "    size_category=\"small\",\n",
    ")\n",
    "\n",
    "print(\"Training + TSTR completed\")\n",
    "print(\"Results saved to:\", ROOT / \"Results\" / dataset_name)\n",
    "print(result)\n"
   ]
  },
